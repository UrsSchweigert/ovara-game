{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A quest: fetch, discover or puzzle, with steps, what clears it and what it sets.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "giver",
    "chapters",
    "steps",
    "clears",
    "sets"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "kind": {
      "enum": [
        "fetch",
        "discover",
        "puzzle"
      ]
    },
    "giver": {
      "$ref": "content-defs.schema.json#/$defs/canon_id"
    },
    "chapters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "content-defs.schema.json#/$defs/chapter"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "intent",
          "points",
          "difficulty"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "difficulty": {
            "enum": [
              8,
              10,
              12,
              14
            ]
          },
          "kind": {
            "enum": [
              "fetch",
              "discover",
              "puzzle"
            ]
          },
          "area": {
            "$ref": "content-defs.schema.json#/$defs/content_id"
          },
          "requires": {
            "description": "Condition that clears the step. Completion is kept in quest state, not in a flag.",
            "$ref": "content-defs.schema.json#/$defs/condition"
          },
          "sets": {
            "type": "array",
            "items": {
              "$ref": "content-defs.schema.json#/$defs/flag"
            }
          }
        }
      }
    },
    "side": {
      "description": "A side quest closes when its place is lost; a stage does not.",
      "type": "boolean"
    },
    "place": {
      "$ref": "content-defs.schema.json#/$defs/content_id"
    },
    "clears": {
      "$ref": "content-defs.schema.json#/$defs/flag"
    },
    "sets": {
      "type": "array",
      "items": {
        "$ref": "content-defs.schema.json#/$defs/flag"
      }
    }
  }
}
