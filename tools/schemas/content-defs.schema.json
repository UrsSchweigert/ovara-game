{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovara.invalid/schemas/content-defs.schema.json",
  "description": "Shared definitions for content schemas. A map is a list of text rows plus a legend: every glyph used in a row must be a key of the legend, and all rows have the same length.",
  "$defs": {
    "canon_id": {"type": "string", "pattern": "^[a-z]+\\.[a-z0-9-]+$"},
    "chapter": {"type": "integer", "minimum": 1, "maximum": 18},
    "flag": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "legend": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 1},
      "additionalProperties": {"type": "object"}
    }
  }
}
