{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A person's sheet: four attributes, Reach from canon, skills with steps, traits by canon id.",
  "type": "object",
  "required": [
    "id",
    "canon",
    "attributes",
    "reach",
    "skills",
    "traits"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "$ref": "content-defs.schema.json#/$defs/content_id"
    },
    "canon": {
      "$ref": "content-defs.schema.json#/$defs/canon_id"
    },
    "attributes": {
      "$ref": "content-defs.schema.json#/$defs/attributes"
    },
    "reach": {
      "$ref": "content-defs.schema.json#/$defs/reach"
    },
    "skills": {
      "$ref": "content-defs.schema.json#/$defs/skills"
    },
    "traits": {
      "$ref": "content-defs.schema.json#/$defs/trait_ids"
    },
    "join_chapter": {
      "$ref": "content-defs.schema.json#/$defs/chapter"
    },
    "area": {
      "description": "Area id where the person stands.",
      "$ref": "content-defs.schema.json#/$defs/content_id"
    },
    "cell": {
      "$ref": "content-defs.schema.json#/$defs/cell"
    },
    "topics": {
      "description": "What the person talks about, by chapter and flag: a dialogue id (see content-dialogue) and a topic it holds.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic",
          "dialogue"
        ],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "$ref": "content-defs.schema.json#/$defs/canon_id"
          },
          "dialogue": {
            "$ref": "content-defs.schema.json#/$defs/content_id"
          },
          "when": {
            "$ref": "content-defs.schema.json#/$defs/condition"
          }
        }
      }
    }
  }
}
