{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A cut scene: a script of walk, say, camera and light steps. Can be skipped.",
  "type": "object",
  "required": [
    "id",
    "steps"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "skippable": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "op",
              "who",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "walk"
              },
              "who": {
                "$ref": "content-defs.schema.json#/$defs/canon_id"
              },
              "to": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "who",
              "lines"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "say"
              },
              "who": {
                "$ref": "content-defs.schema.json#/$defs/canon_id"
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "camera"
              },
              "to": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "level"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "light"
              },
              "level": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        ]
      }
    }
  }
}
