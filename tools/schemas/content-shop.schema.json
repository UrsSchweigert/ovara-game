{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A shop is a person with a stock list by chapter.",
  "type": "object",
  "required": [
    "id",
    "person",
    "stock"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "person": {
      "$ref": "content-defs.schema.json#/$defs/canon_id"
    },
    "stock": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "from_chapter": {
            "$ref": "content-defs.schema.json#/$defs/chapter"
          },
          "to_chapter": {
            "$ref": "content-defs.schema.json#/$defs/chapter"
          },
          "when": {
            "$ref": "content-defs.schema.json#/$defs/condition"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          }
        }
      }
    }
  }
}
