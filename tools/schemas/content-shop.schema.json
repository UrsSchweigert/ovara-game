{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A shop is a stall with a keeper and, by chapter, goods to swap for goods. No coin and no price.",
  "type": "object",
  "required": [
    "id",
    "stock"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "person": {
      "$ref": "content-defs.schema.json#/$defs/canon_id"
    },
    "stock": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "from_chapter": {
            "$ref": "content-defs.schema.json#/$defs/chapter"
          },
          "to_chapter": {
            "$ref": "content-defs.schema.json#/$defs/chapter"
          },
          "when": {
            "$ref": "content-defs.schema.json#/$defs/condition"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "trades": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "gives",
                "wants"
              ],
              "additionalProperties": false,
              "properties": {
                "gives": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "wants": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "keeper": {
      "type": "object",
      "required": [
        "place",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "place": {
          "$ref": "content-defs.schema.json#/$defs/canon_id"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "area": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "person"
      ]
    },
    {
      "required": [
        "keeper"
      ]
    }
  ]
}
