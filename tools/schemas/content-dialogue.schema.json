{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Dialogue by person: topics are canon ids with chapter or flag conditions. A panel holds at most three short lines.",
  "type": "object",
  "required": [
    "id",
    "person",
    "topics"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "person": {
      "$ref": "content-defs.schema.json#/$defs/canon_id"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "topic",
          "panels"
        ],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "$ref": "content-defs.schema.json#/$defs/canon_id"
          },
          "when": {
            "$ref": "content-defs.schema.json#/$defs/condition"
          },
          "panels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "speaker",
                "lines"
              ],
              "additionalProperties": false,
              "properties": {
                "speaker": {
                  "$ref": "content-defs.schema.json#/$defs/canon_id"
                },
                "portrait": {
                  "type": "string",
                  "minLength": 1
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "names_hero": {
            "description": "The topic tells the hero his name; the rules hold it back before chapter 7.",
            "type": "boolean"
          },
          "sets": {
            "description": "Flags set when the topic has been heard; only flags listed in docs/design/quests.md.",
            "type": "array",
            "items": {
              "$ref": "content-defs.schema.json#/$defs/flag"
            }
          },
          "next": {
            "description": "Topic ids this topic opens.",
            "type": "array",
            "items": {
              "$ref": "content-defs.schema.json#/$defs/canon_id"
            }
          }
        }
      }
    }
  }
}
